# Foundry hosted entrypoint requires a model endpoint and deployment.
# Use the Azure OpenAI resource endpoint, NOT the Foundry project endpoint.
AZURE_OPENAI_ENDPOINT=
# Provisioning uses the model name (gpt-5-mini by default); copy the actual output.
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Legacy model aliases remain supported by the server.
AZURE_OPENAI_API_ENDPOINT=
MODEL_DEPLOYMENT_NAME=

# Foundry Agent Server port (the container defaults to 8088).
# PORT, when provided by the hosting platform, takes precedence over this alias.
DEFAULT_AD_PORT=8088
# Set true for local Swagger at /docs on the same Responses server.
ENABLE_SWAGGER=false
# Avoid logging student messages and model content in telemetry by default.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Optional image repository:
DOCKER_REPO_NAME=math-tutor-api
